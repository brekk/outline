import File from "File"
import Path from "FilePath"
import IO from "IO"
import Term from "Terminal"

import EnsignPrint from "ensign/Print"
import MJ from "mad-at-json"
import VL from "mad-at-json/VersionDotLock"

import Log from "@/Log"
import { VERSION } from "@/Version"



export create = (
  { madlibJson, cwd, force, showHelp, useColor, showVersion, versionDotLock },
  flags
) => if (showHelp) {
  EnsignPrint.renderRoundedHelp(
    {
      name: "outline",
      description: "\nauto generate table-based testing stubs\n",
      preface: "",
      useColor,
    },
    flags,
  )
} else if (showVersion) {
  useColor ? Term.text.bold("outline@" ++ VERSION) : "outline@" ++ VERSION
} else do {
  Log.env.outline("RAW", { madlibJson, versionDotLock })
  return ""
}
