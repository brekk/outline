import type { OutlineConfig } from "@/Config"

import Either from "Either"
import IO from "IO"
import List from "List"
import Process from "Process"
import Wish from "Wish"

import Declared from "ensign/Declared"
import Print from "ensign/Declared/Print"
import Flags from "ensign/Flags"

import Cli from "@/Cli"
import { DEFAULT_CONFIG, FLAGS } from "@/Config"
import Log from "@/Log"
import Outline from "@/Outline"



main = pipe(
  List.drop(1),
  Cli.parseState,
  chain(Outline.createWithFlags(FLAGS)),
  Wish.fulfill(
    (x) => {
      IO.putLine(x)
      return Process.exit(1)
    },
    (y) => {
      IO.putLine(y)
      return Process.exit(0)
    },
  ),
  (_) => {},
)
