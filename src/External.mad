import IO from "IO"
import Wish from "Wish"

import Shroud from "shroud"



export git = Shroud.walk("git")
export safeSpace = (goodPath, x) => pipe(
  git,
  map(IO.pTrace(":YO")),
  map((_) => true),
  Wish.chainRej((_) => Wish.good(false)),
  map((yes) => yes ? chain(goodPath, x) : x),
)(["status"])
