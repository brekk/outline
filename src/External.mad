import type { OutlineProblem } from "@/Error"

import Wish from "Wish"

import SafeSpace from "safespace"
import Whim from "whim"
import F from "whim/Failure"

import Problem from "@/Error"



getUnstaged :: String -> Whim a
export getUnstaged = (path) => pipe(
  SafeSpace.getUnstaged,
  Wish.mapRej((_) => Problem.OutlineError("getUnstaged", "Failed to process '" ++ path ++ "'")),
  Whim.fromBreakableWish,
)(path)
checkGitStatus :: String -> Whim a
export checkGitStatus = (path) => pipe(
  SafeSpace.check,
  Wish.mapRej((_) => Problem.OutlineError("checkGitStatus", "Failed to check '" ++ path ++ "'")),
  Whim.fromBreakableWish,
)(path)
