import type { Wish } from "Wish"

import type { Flag } from "ensign/Flags"
import type { MadlibDotJson } from "mad-at-json/MadlibDotJson"
import type { VersionDotLock } from "mad-at-json/VersionDotLock"
import type { Whim } from "whim"

import type { OutlineConfig } from "@/Config"

import Either from "Either"
import Path from "FilePath"
import List from "List"
import { Just } from "Maybe"

import Declared from "ensign/Declared"
import Print from "ensign/Declared/Print"
import Flags from "ensign/Flags"
import VersionDotLock from "mad-at-json/VersionDotLock"
import Whim from "whim"

import { CONSTANTS } from "@/Config"
import C from "@/Config"
import Problem from "@/Error"
import External from "@/External"
import _File from "@/File"
import Log from "@/Log"



export parseFlags = pipe(
  Flags.parseFlags,
  Declared.validate(C.FLAGS),
  Either.mapLeft(Print.printIssues),
)
addFlagToState :: OutlineConfig -> Flag -> OutlineConfig
export addFlagToState = (state, flag) => where(flag) {
  Flags.Flag(k, v) =>
    if (k == "cwd") {
      { ...state, cwd: Just(v) }
    } else if (k == "madlibJson") {
      { ...state, madlibJsonPath: Just(v) }
    } else if (k == "versionLock") {
      { ...state, versionLockPath: Just(v) }
    } else {
      state
    }

  Flags.FlagToggle(k, v) =>
    if (k == "color") {
      { ...state, useColor: v }
    } else if (k == "force") {
      { ...state, force: v }
    } else if (k == "strict") {
      { ...state, strict: v }
    } else if (k == "version") {
      { ...state, showVersion: v }
    } else if (k == "help") {
      { ...state, showHelp: v }
    } else {
      state
    }

  _ =>
    state
}
getMadlibJsonFromState :: OutlineConfig -> Whim MadlibDotJson
export getMadlibJsonFromState = pipe(
  (x) => Path.joinPath([(x.cwd ?? "."), (x.madlibJsonPath ?? CONSTANTS.MADLIB_JSON)]),
  _File.readMadlibJsonWhim,
)
getVersionLockFromState :: OutlineConfig -> Whim VersionDotLock
export getVersionLockFromState = pipe(
  (x) => Path.joinPath([(x.cwd ?? "."), (x.versionLockPath ?? CONSTANTS.VERSION_LOCK)]),
  _File.readVersionLockWhim,
)
parseStateFromArgs :: List String -> Either String OutlineConfig
export parseStateFromArgs = pipe(
  Log.env.cli("raw args"),
  parseFlags,
  Log.env.cliParse("parsed flags"),
  map(
    pipe(
      List.reduce(addFlagToState, C.DEFAULT_CONFIG),
      Log.env.cliState("inferred state"),
    ),
  ),
)
runModal = (otherwise, state) => if (state.showHelp || state.showVersion) {
  of(state)
} else {
  otherwise(state)
}
// do crimes but get away
addOptional = (processor, raw) => pipe(
  chain(runModal(processor)),
  // we're catching broadly, but we may want to focus this later
  Whim.catchTag("outline:error", (_) => raw),
)(raw)
processGitStatus :: OutlineConfig -> Whim OutlineConfig
processGitStatus = (state) => do {
  status <- External.checkGitStatus(state.cwd ?? ".")
  return of({ ...state, status })
}
processMadlibJson :: OutlineConfig -> Whim OutlineConfig
processMadlibJson = (state) => do {
  madlibJson <- getMadlibJsonFromState(state)
  return of({ ...state, madlibJson: Just(madlibJson) })
}
processVersionLock :: OutlineConfig -> Whim OutlineConfig
processVersionLock = (state) => do {
  versionLock <- getVersionLockFromState(state)
  return of({ ...state, versionDotLock: Just(versionLock) })
}
parseState :: List String -> Whim OutlineConfig
export parseState = pipe(
  parseStateFromArgs,
  where {
    Either.Left(x) =>
      Whim.bad(Problem.resolver(Problem.OutlineError("cli", "parseState")))

    Either.Right(state) =>
      of(state)
  },
  // we expect any of these can fail
  addOptional(processMadlibJson),
  addOptional(processGitStatus),
  addOptional(processVersionLock),
)
