import type { Flag } from "ensign/Flags"
import type { MadlibDotJson } from "mad-at-json/MadlibDotJson"
import type { VersionDotLock } from "mad-at-json/VersionDotLock"

import type { OutlineConfig } from "@/Config"

import Either from "Either"
import File from "File"
import Path from "FilePath"
import IO from "IO"
import List from "List"
import Maybe from "Maybe"
import { Just } from "Maybe"
import Wish from "Wish"

import Declared from "ensign/Declared"
import Print from "ensign/Declared/Print"
import Flags from "ensign/Flags"
import MadlibJson from "mad-at-json"
import VersionDotLock from "mad-at-json/VersionDotLock"

import { CONSTANTS } from "@/Config"
import C from "@/Config"
import Ext from "@/External"
import _File from "@/File"
import Log from "@/Log"



export parseFlags = pipe(
  Flags.parseFlags,
  Declared.validate(C.FLAGS),
  Either.mapLeft(Print.printIssues),
)
addFlagToState :: OutlineConfig -> Flag -> OutlineConfig
export addFlagToState = (state, flag) => where(flag) {
  Flags.Flag(k, v) =>
    if (k == "cwd") {
      { ...state, cwd: Just(v) }
    } else if (k == "madlibJson") {
      { ...state, madlibJsonPath: Just(v) }
    } else if (k == "versionLock") {
      { ...state, versionLockPath: Just(v) }
    } else {
      state
    }

  Flags.FlagToggle(k, v) =>
    if (k == "color") {
      { ...state, useColor: v }
    } else if (k == "force") {
      { ...state, force: v }
    } else if (k == "version") {
      { ...state, showVersion: v }
    } else if (k == "help") {
      { ...state, showHelp: v }
    } else {
      state
    }

  _ =>
    state
}
getMadlibJsonFromState :: OutlineConfig -> Wish String MadlibDotJson
export getMadlibJsonFromState = pipe(
  (x) => Path.joinPath([(x.cwd ?? "."), (x.madlibJsonPath ?? CONSTANTS.MADLIB_JSON)]),
  _File.readMadlibJson,
)
getVersionLockFromState :: OutlineConfig -> Wish String VersionDotLock
export getVersionLockFromState = pipe(
  (x) => Path.joinPath([(x.cwd ?? "."), (x.versionLockPath ?? CONSTANTS.VERSION_LOCK)]),
  _File.readVersionLock,
)
parseStateFromArgs :: List String -> Either String OutlineConfig
export parseStateFromArgs = pipe(
  Log.env.cli("raw args"),
  parseFlags,
  Log.env.cliParse("parsed flags"),
  map(
    pipe(
      List.reduce(addFlagToState, C.DEFAULT_CONFIG),
      Log.env.cliState("inferred state"),
    ),
  ),
)
processMadlibJson = (state) => if (state.showHelp || state.showVersion) {
  of(state)
} else do {
  madlibJson <- getMadlibJsonFromState(state)
  return of({ ...state, madlibJson: Just(madlibJson) })
}
processVersionLock = (state) => if (state.showHelp || state.showVersion) {
  of(state)
} else do {
  versionLock <- getVersionLockFromState(state)
  return of({ ...state, versionDotLock: Just(versionLock) })
}
export parseStateFromArgsAndRead = pipe(
  parseStateFromArgs,
  where {
    Either.Left(x) =>
      Wish.bad(x)

    Either.Right(state) =>
      processMadlibJson(state)
  },
  // chain(Ext.safeSpace(of)),
  // we gotta grab these separately because version.lock might not exist
  (raw) => pipe(
    chain(processVersionLock),
    // failures give us the original, recovering from the missing file 
    Wish.chainRej((_) => raw),
  )(raw),
)
