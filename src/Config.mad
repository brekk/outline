import type { Maybe } from "Maybe"
import type { Wish } from "Wish"

import type { MadlibDotJson } from "mad-at-json/MadlibDotJson"
import type { VersionDotLock } from "mad-at-json/VersionDotLock"

import { Nothing } from "Maybe"
import Wish from "Wish"

import DFlag from "ensign/Declared/Flags"



// we express cwd + madlibJson as Maybes so that we can capture whether
// the user provided an input at all
export alias OutlineConfig = {
  cwd :: Maybe String,
  force :: Boolean,
  madlibJson :: Maybe MadlibDotJson,
  madlibJsonPath :: Maybe String,
  showHelp :: Boolean,
  showVersion :: Boolean,
  status :: { git :: Boolean, uncommitted :: Boolean, unstaged :: Boolean },
  strict :: Boolean,
  useColor :: Boolean,
  versionDotLock :: Maybe VersionDotLock,
  versionLockPath :: Maybe String,
}
export CONSTANTS = {
  cwd: "cwd",
  force: "force",
  help: "help",
  strict: "strict",
  color: "color",
  version: "version",
  madlibJson: "madlibJson",
  versionLock: "versionLock",
  DEFAULT_CWD: ".",
  MADLIB_JSON: "madlib.json",
  VERSION_LOCK: "version.lock",
}
DEFAULT_CONFIG :: OutlineConfig
export DEFAULT_CONFIG = {
  cwd: Nothing,
  useColor: true,
  showHelp: false,
  force: false,
  showVersion: false,
  madlibJson: Nothing,
  madlibJsonPath: Nothing,
  versionDotLock: Nothing,
  versionLockPath: Nothing,
  strict: false,
  status: { git: false, uncommitted: false, unstaged: false },
}
export FLAGS = [
  DFlag.flagString(
    CONSTANTS.cwd,
    ["c"],
    "The current working directory. (Default: " ++ CONSTANTS.DEFAULT_CWD ++ ")",
  ),
  DFlag.flagBoolean(CONSTANTS.color, ["K"], "Render things with color? (Default: true)"),
  DFlag.flagBoolean(CONSTANTS.version, ["v"], "Show the version (Default: false)"),
  DFlag.flagBoolean(
    CONSTANTS.force,
    ["f"],
    "Automatically overwrite files if they exist. This will set `strict` to false if both are set. (Default: false)",
  ),
  DFlag.flagBoolean(
    CONSTANTS.strict,
    ["s"],
    "Be version-control context aware (git only) and warn when attempting to change with uncommitted or unstaged changes in conflict. (Default: true)",
  ),
  DFlag.flagBoolean(CONSTANTS.help, ["h"], "Show the help text you're reading right now"),
  DFlag.flagString(
    CONSTANTS.madlibJson,
    ["m"],
    "Set the path of madlib.json. (Default: " ++ CONSTANTS.MADLIB_JSON ++ ")",
  ),
  DFlag.flagString(
    CONSTANTS.versionLock,
    ["l"],
    "Set the path of version.lock. (Default: " ++ CONSTANTS.VERSION_LOCK ++ ")",
  ),
]
